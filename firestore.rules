rules_version = '2';

// Regras de acesso do Firestore (pendência da seção 26 / seção 13).
// Catálogo: leitura para qualquer Cliente logado; escrita só pelo console.
// Dados do Cliente: cada um só lê/escreve os seus.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }

    match /categorias/{id} {
      allow read: if logado();
      allow write: if false;
    }

    match /locais/{id} {
      allow read: if logado();
      allow write: if false;
    }

    match /avaliacoes/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.clienteId == request.auth.uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1 && request.resource.data.nota <= 5;
      allow update, delete: if dono(resource.data.clienteId);
    }

    match /clientes/{uid} {
      allow read, write: if dono(uid);

      match /roteiros/{roteiroId} {
        allow read, write: if dono(uid);
      }
    }
  }
}
